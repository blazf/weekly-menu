# --- admin ---------------------------------------------------------------
# Password for /admin. Change this.
ADMIN_PASSWORD=changeme
# Random string used to sign the admin cookie and vote tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=replace-with-a-long-random-string

# --- app -----------------------------------------------------------------
# Base URL family members will click. Use your server's LAN address.
APP_URL=http://192.168.1.10:3000

# --- family --------------------------------------------------------------
# Comma-separated Name:email pairs. Email may be omitted for copy-link only.
FAMILY=Blaz:blaz@example.com,Ana:ana@example.com,Miha:

# --- email (optional) ----------------------------------------------------
# Leave SMTP_HOST empty to run in preview mode: the admin page shows the
# rendered email and per-person links to copy manually. Nothing is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lunch <lunch@example.com>"
